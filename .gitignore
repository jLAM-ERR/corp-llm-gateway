# operator-provided corp CA bundle — never commit real internal PKI material
crt/*.pem
crt/*.crt

# compose/ production stack — operator secrets and staged/site-specific material
compose/.env
compose/certs/*.pem
compose/certs/*.crt
compose/certs/*.key
compose/certs/*.p12
compose/certs/*.pfx
# nginx's cert and key names are free-form (NGINX_TLS_CERT / NGINX_TLS_KEY), so
# ignore everything there but the README.
compose/nginx/certs/*
!compose/nginx/certs/README.md
compose/postgres/initdb/*.sql
compose/gateway/config.toml

# Internal research, decision records, and benchmarks — maintainer / product-owner only.
# Kept on disk locally, excluded from the published tree (see README: only public docs are linked).
docs/adr/
docs/plans/
docs/requirements-compliance.md
docs/remaining-steps.md
scripts/bench_local_first.py
# Research / benchmark virtualenvs (NER bench + DeepPavlov comparison)
.venv-bench/
.venv-dp/
.claude/prompts/

# Corp NER connection doc — holds the internal endpoint/credentials. Never commit.
connect-corp-ner.pdf
*-corp-ner.pdf

# revmux review archive — per-round agent transcripts, local only. The project
# profile (.revmux/profile.md) IS tracked; only the task archive is ignored.
.revmux/tasks/
