CORP_LLM_ENDPOINT=https://corp-llm.corp.lan
CORP_LLM_AUTH_PROVIDER=noop
# Empty intentionally — corp LLM is currently auth-less. The litellm-config.yaml
# references this via os.environ/CORP_LLM_AUTH_TOKEN; declaring it here (even
# empty) avoids LiteLLM v1.85 startup errors when the env var is undefined.
CORP_LLM_AUTH_TOKEN=
# Sanitized external requests from the chatgpt-codex profile are sent here.
# OAuth credentials are supplied per request by Codex and are never stored here.
CHATGPT_CODEX_API_BASE=https://chatgpt.com/backend-api/codex
#
# Claude Code / anthropic-oauth profile — CLIENT-SIDE ONLY.
# ANTHROPIC_BASE_URL, ANTHROPIC_AUTH_TOKEN and ANTHROPIC_CUSTOM_HEADERS belong in
# your LAPTOP shell; source docker/anthropic-oauth/claude-env.sh, which is the one
# place the corp-identity header layout is written. Do NOT set them here: this file
# is env_file for the litellm container, and litellm reads both names from its own
# process env — ANTHROPIC_BASE_URL would point the container's upstream calls back
# at itself, and ANTHROPIC_AUTH_TOKEN would become a shared server-side fallback
# credential (llms/anthropic/common_utils.py get_secret_str("ANTHROPIC_AUTH_TOKEN")),
# masking a broken bridge and destroying per-developer attribution.
# populated by scripts/demo.sh seed-langfuse:
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
