[Unit]
Description=corp-llm-gateway production compose stack
Documentation=https://github.com/jLAM-ERR/corp-llm-gateway/blob/master/compose/README.md
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
# Compose owns the containers; systemd only starts and stops the stack.
Type=oneshot
RemainAfterExit=yes
# bootstrap-server.sh rewrites this line when --dir is not the default.
WorkingDirectory=/opt/corp-llm-gateway
# Compose reads the stack's configuration from ./.env in WorkingDirectory.
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
