# behind-proxy, port routing (the no-DNS fallback): the gateway on 8080 and
# Langfuse on 8081, whatever the Host. Langfuse v3 cannot be sub-path hosted,
# so it needs an origin of its own.

server {
    listen 8080 default_server;
    server_name _;
    include /etc/nginx/rendered/snippets/gateway-locations.inc;
}

server {
    listen 8081 default_server;
    server_name _;
    include /etc/nginx/rendered/snippets/langfuse-locations.inc;
}
