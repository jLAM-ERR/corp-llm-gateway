# terminate, port routing (the no-DNS fallback): TLS on 8080 for the gateway
# and on 8081 for Langfuse, whatever the name. nginx is the public TLS
# endpoint, so there is no trusted-peer gate. The certificate must carry the
# IP or local name clients dial. No plain listener and no :80 redirect; HSTS
# only on the TLS blocks here.

server {
    listen 8080 ssl default_server;
    server_name _;
    ssl_certificate /etc/nginx/certs/${NGINX_TLS_CERT};
    ssl_certificate_key /etc/nginx/certs/${NGINX_TLS_KEY};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    add_header Strict-Transport-Security "max-age=31536000" always;
    include /etc/nginx/rendered/snippets/gateway-locations.inc;
}

server {
    listen 8081 ssl default_server;
    server_name _;
    ssl_certificate /etc/nginx/certs/${NGINX_TLS_CERT};
    ssl_certificate_key /etc/nginx/certs/${NGINX_TLS_KEY};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    add_header Strict-Transport-Security "max-age=31536000" always;
    include /etc/nginx/rendered/snippets/langfuse-locations.inc;
}
