# The Langfuse origin — the only copy; every listener includes it.
# An origin of its own, never a sub-path: Langfuse v3 is a Next.js app whose
# NEXTAUTH_URL must match the public origin, and sub-path hosting breaks its
# redirects. That is why nginx-ports gives it a port of its own.

# A variable, so nginx starts before langfuse-web exists and re-resolves it
# after a restart (the resolver line is in 00-http).
set $langfuse_upstream http://langfuse-web:3000;

proxy_http_version 1.1;
proxy_buffering off;
proxy_request_buffering off;
proxy_read_timeout 3600s;
chunked_transfer_encoding on;
# With both buffers off nothing is written to a temp file. A temp-file fault is
# a [crit] entry, and nginx appends the request line (query string included).
proxy_max_temp_file_size 0;

# The one snippet that forwards a WebSocket upgrade (the maps are in 00-http).
proxy_set_header Upgrade $http_upgrade;
proxy_set_header Connection $connection_upgrade;
# The Host header with its port: NextAuth checks it against NEXTAUTH_URL, and
# $host drops the port on a non-default one.
proxy_set_header Host $proxy_host_header;
# The literal: the public side is always HTTPS, and $scheme is http in
# behind-proxy.
proxy_set_header X-Forwarded-Proto https;

location / {
    proxy_pass $langfuse_upstream$request_uri;
}
