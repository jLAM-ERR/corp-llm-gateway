# corp-llm-gateway production compose — copy to .env (mode 0600) and edit.
# See compose/README.md. Never commit the edited .env (it is git-ignored).

# ---- Gateway image ----------------------------------------------------------
# Tag of ghcr.io/jlam-err/corp-llm-gateway to pull. The prebuilt image is used
# as-is — compose never rebuilds it. Floor pinned to the tag this stack's
# routing (per-model-prefix anthropic/openai/hosted_vllm) was verified
# against (litellm v1.85.0 baked in) — see examples/compose/README.md "BYOK
# in local mode (SPIKE finding)". Bump deliberately, not blindly; check the
# package listing first:
# https://github.com/jLAM-ERR/corp-llm-gateway/pkgs/container/corp-llm-gateway
#
# This tag predates Workstream B's corp NER integration and may predate
# CORP_LLM_STRIP_INBOUND_HEADERS too — see compose/README.md "Building from
# this branch" for docker-compose.build.yml, which runs the current branch's
# code instead of this tag. Bumping this to an rc containing the corp NER
# work is a release gate before this stack is production-ready.
GATEWAY_IMAGE_TAG=1.0.0-rc.5

# Host port the data-plane litellm proxy listens on (bound to 127.0.0.1 —
# see compose/README.md "Loopback bind").
GATEWAY_PORT=4000

# ---- Postgres (token store + team config + litellm's own virtual-key DB) ---
POSTGRES_USER=gateway
POSTGRES_PASSWORD=
POSTGRES_DB=gateway

# ---- Deployment posture ------------------------------------------------------
# Arms the F9 guard (config.py is_prod()): refuses SSL_VERIFY=false on the
# corp-LLM ORACLE call specifically, which carries raw user content. F9 is
# reached only when CORP_LLM_ORACLE_ENABLED=1 (off by default below) — see
# compose/README.md "TLS verification is always on" for how litellm's own
# global SSL_VERIFY read is covered on this stack regardless. Leave as
# "production" for a real deploy.
CORP_ENV=production
# Fail closed when NER is absent (F2) instead of silently returning no
# findings. Load-bearing in production; do not set to 0 here.
CORP_LLM_REQUIRE_NER=1

# ---- Developer credential: LiteLLM virtual keys -----------------------------
# Litellm intercepts the inbound `Authorization: Bearer <virtual-key>` header
# and validates it against its own key store — see compose/README.md
# "Virtual keys". Generate: `openssl rand -hex 32`, prefixed `sk-`.
LITELLM_MASTER_KEY=
# Admin UI (http://127.0.0.1:4000/ui — plain HTTP, loopback-only until the
# nginx/TLS profile lands) basic-auth credentials.
UI_USERNAME=
UI_PASSWORD=

# ---- Gateway-held provider keys (native anthropic/openai routing) ----------
# Native anthropic/ and openai/ litellm providers build their OWN upstream
# credential from these — they never read the client's Authorization header
# (verified twice; see examples/compose/README.md "BYOK in local mode (SPIKE
# finding)"). Set whichever provider(s) you actually route to claude-*/gpt-*.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Corp vLLM oracle (CORP_LLM_* — see src/corp_llm_gateway/settings.py) ---
# Base URL (…/v1) of the corp vLLM. Feeds BOTH the gateway's own oracle
# client (local-first cascade's conditional fallback) and, when set, the
# litellm corp-* model route (hosted_vllm/, see litellm/config.yaml — NOT
# BYOK: no inbound Authorization reaches any upstream on this stack, on any
# route; see compose/README.md "Why not BYOK"). Required only when
# CORP_LLM_ORACLE_ENABLED=1 below, or when you use the corp-* route —
# leaving it unset does NOT disable the oracle by itself (see
# CORP_LLM_ORACLE_ENABLED); the claude-*/gpt-* routes are unaffected either
# way.
CORP_LLM_ENDPOINT=
# Oracle auth mode: noop | bearer | mtls | oidc | apikey. The corp vLLM is
# auth-less today, so noop is the correct default.
CORP_LLM_AUTH_PROVIDER=noop
# Legacy oracle bearer token (also the litellm corp-* model_list api_key).
# Leave empty for an auth-less corp vLLM.
CORP_LLM_AUTH_TOKEN=
# Upstream model the corp vLLM exposes. Must match the literal hardcoded in
# litellm/config.yaml's corp-* model_list entry — edit both together if you
# change this.
CORP_LLM_MODEL=GLM-5.1-AWQ
# Enables the corp-LLM oracle (local-first cascade's conditional fallback).
# Default OFF: with the oracle on and no reachable CORP_LLM_ENDPOINT, a
# gazetteer hit reaches the placeholder endpoint and fails the request
# closed — on EVERY route, not just corp-*. Set to 1 only once
# CORP_LLM_ENDPOINT points at a reachable corp vLLM.
# Coupled to CORP_LLM_LOCAL_FIRST (not set here, so it keeps its settings.py
# default "1"): bootstrap.build_guardrail() refuses to boot
# (ConfigError(NO_OP_SANITIZER_MESSAGE)) if BOTH are off. Don't set
# CORP_LLM_LOCAL_FIRST=0 without also setting this to 1.
CORP_LLM_ORACLE_ENABLED=0
# Load-bearing, not reserved: our own guardrail sets data["headers"]
# UNCONDITIONALLY in CorpLlmGuardrail._pre_call_impl, independent of
# litellm's own forward_client_headers_to_llm_api gate — so whatever inbound wire headers
# (Host, User-Agent, ...) land there get forwarded to the upstream provider
# call regardless of that gate. This flag strips them first. Wire-verified
# on both corp-*/hosted_vllm and native claude-*/gpt-* routes. Keep "1" —
# see compose/README.md "Why not BYOK".
CORP_LLM_STRIP_INBOUND_HEADERS=1

# ---- Corp NER service (CORP_NER_* — see src/corp_llm_gateway/settings.py) ---
# Optional remote NER detector, appended to the local-first cascade. OFF by
# default; leaving this at 0 keeps the stack byte-identical to a deploy that
# never heard of it (no detector, no readiness probe).
#
# Turning it on takes BOTH keys: with CORP_NER_ENABLED=1 and no endpoint the
# container refuses to boot (bootstrap.build_corp_ner(), and
# `gateway-admin config check`) rather than starting with the detector
# silently missing. The endpoint is the service BASE url — the client appends
# /v1/analyze.
CORP_NER_ENABLED=0
# CORP_NER_ENDPOINT=http://corp-ner.corp.lan:8004
#
# The four keys below are commented ON PURPOSE, not for tidiness. They are
# passed to the container by bare name, so a commented line means the variable
# is ABSENT there and the code default applies (30s, 256 texts, 200000 chars,
# no CA bundle). Writing `CORP_NER_TIMEOUT_S=` instead sets it to an EMPTY
# STRING, which is not the same thing: an empty env var beats the config file
# in config.get(), so it would shadow any value in a mounted
# /etc/corp-llm-gateway/config.toml and make `gateway-admin config check`
# report '' instead of the effective default. Uncomment only to override.
#
# Timeout is deliberately under the service's own 60s. Batch caps mirror the
# service's limits — a single text longer than the char cap fails CLOSED (corp
# NER has no fail-open path: an unscanned text never reads as clean).
# CORP_NER_TIMEOUT_S=30
# CORP_NER_MAX_TEXTS=256
# CORP_NER_MAX_INPUT_CHARS=200000
# TLS trust for the NER call. This request carries RAW user content, so
# verification is never disabled for it — there is no SSL_VERIFY-style escape
# hatch. If the service presents an internal-CA cert, point this at the PEM
# chain (the same mount as CORP_LLM_CA_BUNDLE below works:
# compose/certs/README.md).
# CORP_NER_CA_BUNDLE=/etc/corp-llm-gateway/certs/corp-ca-bundle.pem

# ---- Self-hosted Langfuse v3 -------------------------------------------------
# Request-level traces + the audit trail (see compose/README.md "Langfuse" for
# what Langfuse answers that the LiteLLM UI does not). No Langfuse service
# publishes a host port: reach the UI through the nginx profile or an SSH
# tunnel. Every secret below is required — `docker compose up` refuses to
# start without it rather than reusing the demo stack's
# "change-in-production" placeholders.
#
# Generate each with `openssl rand -hex 32` (hex, so it stays safe inside the
# postgres connection URL Langfuse is given).
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
MINIO_ROOT_PASSWORD=
# NextAuth session secret and the hashing salt. `openssl rand -base64 32`.
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
# Encrypts API keys and integration credentials at rest in Langfuse's own
# database. Must be EXACTLY 64 hex characters: `openssl rand -hex 32`.
# Changing it later makes existing encrypted rows unreadable.
LANGFUSE_ENCRYPTION_KEY=
# MinIO access-key id (the S3 credential Langfuse uses for event uploads) and
# the bucket minio-init creates. Defaults are fine.
MINIO_ROOT_USER=langfuse
LANGFUSE_S3_BUCKET=langfuse
# Memory caps for langfuse-redis — Langfuse's INGESTION QUEUE, not Cache B
# (Cache B is the gateway `redis`, capped in compose/redis/redis.conf; don't
# confuse the two). Both caps are needed: the first is Redis's own data cap,
# the second the container RSS backstop, so a runaway queue can never make the
# host OOM killer choose between litellm, postgres and Cache B. Keep the
# second roughly 2x the first — Redis RSS exceeds maxmemory (fragmentation,
# client output buffers, AOF-rewrite copy-on-write) and equal values just move
# the kill into the container. The defaults hold a six-figure job backlog,
# i.e. hours of a fully stalled langfuse-worker; steady state is a few MB.
# The eviction policy is deliberately NOT tunable here (hardcoded
# `noeviction`): at the cap Langfuse rejects new ingestion writes loudly
# rather than silently dropping already-accepted events. Raise both together
# if `docker compose exec langfuse-redis redis-cli info memory` sits at the
# cap — see compose/README.md "When the Langfuse queue fills". Never set
# either to 0: 0 means UNLIMITED to both Redis and docker, it renders without
# complaint, and it restores exactly the host-OOM exposure these caps exist to
# remove. Leaving a key empty or deleting it is safe (the same defaults are
# baked into docker-compose.yml); writing 0 is not.
LANGFUSE_REDIS_MAXMEMORY=256mb
LANGFUSE_REDIS_MEM_LIMIT=512mb
# Public origin of the Langfuse UI — must match what the browser sends, or
# NextAuth's sign-in redirect loops. `https://langfuse.<domain>` behind the
# nginx profile; keep the default when reaching it through an SSH tunnel
# that forwards local port 3000.
LANGFUSE_PUBLIC_URL=http://localhost:3000
# Self-service signup is off by default: on a fresh instance anyone who can
# reach the UI could otherwise claim the first (admin) account. Provision the
# first user with the LANGFUSE_INIT_* keys below instead of setting this
# false — with signup off AND no init user there is no way to log in.
LANGFUSE_DISABLE_SIGNUP=true
# Headless init (optional, all-or-nothing). Uncomment to have Langfuse create
# the org, project, first user and the ingestion API keys on first boot; the
# key pair is what the Vector audit sink authenticates with
# (CORP_LANGFUSE_PUBLIC_KEY / CORP_LANGFUSE_SECRET_KEY on the gateway side).
# Leave commented to provision through the UI instead. Do NOT quote the
# values (langfuse parses them literally, quotes included).
# LANGFUSE_INIT_ORG_ID=corp
# LANGFUSE_INIT_ORG_NAME=Corp
# LANGFUSE_INIT_PROJECT_ID=corp-llm-gateway
# LANGFUSE_INIT_PROJECT_NAME=corp-llm-gateway
# LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
# LANGFUSE_INIT_PROJECT_SECRET_KEY=
# LANGFUSE_INIT_USER_EMAIL=
# LANGFUSE_INIT_USER_NAME=
# LANGFUSE_INIT_USER_PASSWORD=

# ---- Audit pipeline (vector) -------------------------------------------------
# Vector tails the gateway's stdout and forwards audit records to Langfuse. It
# is always on — audit is not optional — so BOTH keys below are required and
# `docker compose config` fails without them.
#
# They are the Langfuse PROJECT API keys (public `pk-lf-…` / secret `sk-lf-…`),
# NOT the LANGFUSE_* infrastructure secrets above. Get them from the
# LANGFUSE_INIT_PROJECT_PUBLIC_KEY / _SECRET_KEY pair if you use headless init,
# or from Project Settings -> API Keys in the UI.
#
# Empty is safe, WRONG is not. While they are empty `docker compose config`
# fails, so vector never starts and nothing is lost — its source is
# `read_from: beginning`, so its first run replays the litellm log from byte 0.
# A placeholder value is different: vector starts, Langfuse answers 401, and
# vector's HTTP sink does not retry auth failures (only 408/429/5xx), so those
# audit records are DROPPED. If you provision keys through the UI, keep vector
# out of the stack until the real values are here — `docker compose up -d
# --scale vector=0`. See compose/README.md "First login".
CORP_LANGFUSE_PUBLIC_KEY=
CORP_LANGFUSE_SECRET_KEY=
# Disk buffer for the Langfuse sink, in bytes (default 1 GiB, minimum
# 268435488). This is what makes the ingestion 5xx you get when langfuse-redis
# hits its cap a RETRY rather than a dropped audit record — see
# compose/README.md "When the Langfuse queue fills". Raise it if Langfuse can be
# down for longer than this buffer holds; never replace it with an in-memory
# buffer. It bounds how much Vector holds, NOT how long audit records survive:
# once it is full Vector stops reading and the records wait in the docker log
# files, so docker log retention is the real durability bound — see
# compose/README.md "Audit buffering is not fail-closed".
# CORP_VECTOR_LANGFUSE_BUFFER_BYTES=1073741824
# Docker log rotation for the litellm container — the REAL durability bound on
# audit records, because vector reads them out of these files. Their product
# (default 100m x 10 = ~1 GiB, matching the disk buffer above) must exceed the
# audit bytes litellm produces during the longest Langfuse outage you intend to
# survive; past that, rotation discards records vector has not shipped yet.
#
# They are set on the service, NOT inherited from the daemon, and that is not a
# preference: docker merges daemon-level log-opts into a container only when the
# container's driver equals the daemon's DEFAULT driver. The litellm service
# pins `json-file` (the audit pipeline needs it), so on a host whose daemon
# defaults to `local`/`journald` nothing would be inherited and json-file's own
# default is max-size -1 — no rotation at all. Do not remove them expecting the
# daemon's policy to take over; it will not. See compose/README.md "Audit
# buffering is not fail-closed".
#
# There is no knob for docker's `compress` log-opt, and that is deliberate:
# docker-compose.yml pins it to "false" on the service. Vector's file source
# cannot decompress, so a `.gz` rotation is invisible to the audit pipeline —
# and on a host whose daemon default is ALSO json-file with `compress=true`,
# the merge described above would otherwise turn it on behind your back
# (measured: rotations became `…-json.log.1.gz`). Do not remove the pin.
# LITELLM_LOG_MAX_SIZE=100m
# LITELLM_LOG_MAX_FILE=10
# Where the docker daemon keeps container logs on THIS host. The default is
# right for a stock Linux docker. Change it only if the daemon runs with a
# non-default data-root. The litellm service pins the `json-file` driver itself,
# so a daemon default of `local`/`journald` no longer silences the pipeline —
# but this path must still be the daemon's real container log directory
# (see compose/README.md "Audit pipeline").
# DOCKER_CONTAINERS_DIR=/var/lib/docker/containers
#
# No knob here for the container identity boundary: the litellm service's
# `com.corp-llm-gateway.audit-source` label, its `logging.options.labels` and
# vector.yaml's `gateway_container_only` filter are one hardcoded mechanism, on
# purpose — an operator-settable audit source is a poisoning lever on the audit
# trail (see compose/README.md "Container identity boundary"). That mechanism is
# a MISCONFIGURATION GUARD, not a security boundary: the label is public, so
# anyone able to run `docker run` on this host can set the same label and the
# same --log-opt and forge audit records. "No untrusted docker run on this host"
# is a hard production requirement of this deployment model.
#
# Optional extra audit sinks, both OFF. Each is a separate vector config file
# (compose/vector/sinks-*.yaml) loaded only when its flag is 1; enabling one
# without its settings below makes vector refuse to start rather than silently
# skip the sink.
#   S3 — durable archive of the flat, gated audit record. Credentials come from
#   AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY or the instance role.
CORP_AUDIT_S3_ENABLED=0
# CORP_AUDIT_S3_BUCKET=
# CORP_AUDIT_S3_REGION=
# CORP_VECTOR_S3_BUFFER_BYTES=5368709120
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
#   SIEM — the corp SIEM endpoint and its auth scheme are still an open item,
#   so this ships off and unconfigured. Add the auth block to
#   compose/vector/sinks-siem.yaml when the target is confirmed.
CORP_AUDIT_SIEM_ENABLED=0
# CORP_AUDIT_SIEM_URL=
# CORP_VECTOR_SIEM_BUFFER_BYTES=1073741824

# ---- TLS to the corp vLLM (CA bundle, optional) ------------------------------
# TLS verification is always ON for every upstream on this stack — SSL_VERIFY
# is hardcoded "true" in docker-compose.yml, NOT an .env key: litellm's own
# get_ssl_verify() reads that same variable directly (higher priority than
# SSL_CERT_FILE) for every provider, with no CORP_ENV guard, so it is not
# exposed here as something an operator can flip. See compose/README.md
# "TLS verification is always on" and docs/security.md "Known gaps".
# Uncomment CORP_LLM_CA_BUNDLE when the corp vLLM presents a cert signed by
# an internal CA (drop the chain at compose/certs/corp-ca-bundle.pem first —
# see compose/certs/README.md). Leave commented for a publicly-trusted cert.
# CORP_LLM_CA_BUNDLE covers our own oracle client (httpx) only; the litellm
# container's SSL_CERT_FILE is NOT set here — it always points at a combined
# bundle (certifi public roots + this CA, if present) built at container
# boot, so native anthropic/openai TLS keeps working either way. See
# compose/certs/README.md.
# CORP_LLM_CA_BUNDLE=/etc/corp-llm-gateway/certs/corp-ca-bundle.pem
