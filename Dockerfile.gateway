# Server image: the LiteLLM proxy with the corp-llm-gateway guardrail installed
# as a callback. The sibling `Dockerfile` builds the `gateway-admin` CLI image;
# this one runs the request path.
#
# Base must ship Python >=3.12 (the wheel is `requires-python >=3.12`). Override
# the pin at build time: --build-arg LITELLM_VERSION=v1.40.x
#
# Pinned, not floating: `main-stable` moves under released tags, so two builds of
# the same commit could ship different proxies. v1.95.0 is the latest stable —
# `v1.95.0`, `main-stable` and `latest` resolve to byte-identical manifests
# (verified 2026-08-04). Keep in sync with .github/workflows/build-image.yml,
# scripts/release/gates.sh and the docker/*/Dockerfile demo profiles; the
# previous pins and the rollback recipe are in docs/ops/upgrade.md.
ARG LITELLM_VERSION=v1.95.0

FROM python:3.12-slim AS build
WORKDIR /build
# Proxy CA, same convention as the final stage (crt/proxy-ca.crt, git-ignored —
# see crt/README.md). It has to be here too: `pip install build` below is the
# FIRST network call of the whole build, so behind a TLS-intercepting proxy it
# fails long before the final stage's CA handling is reached. This stage ships
# nothing — only the built wheel is COPYed out — so the trust widening is
# confined to the builder. Unlike the litellm base, python:3.12-slim has no
# certifi, hence the system bundle.
COPY crt/ /tmp/proxy-crt/
RUN set -eux; \
    if [ -f /tmp/proxy-crt/proxy-ca.crt ]; then \
        cat /tmp/proxy-crt/proxy-ca.crt >> /etc/ssl/certs/ca-certificates.crt; \
    fi; \
    rm -rf /tmp/proxy-crt
ENV PIP_CERT=/etc/ssl/certs/ca-certificates.crt \
    REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
RUN pip install --no-cache-dir build
COPY pyproject.toml README.md ./
COPY src/ ./src/
RUN python -m build --wheel

FROM ghcr.io/berriai/litellm:${LITELLM_VERSION}
# This base's /app/.venv is a uv venv with NO pip — ensurepip bootstraps it
# below before installing the wheel (mirrors docker/demo-litellm/Dockerfile:13-18).

# ── Re-signing-proxy CA (absent => ordinary open-internet build) ─────────────
# If internet egress goes through a re-signing (TLS-intercepting) proxy, build-time
# pip must trust the proxy's root CA instead of skipping TLS. Drop it at
# crt/proxy-ca.crt (git-ignored; see crt/README.md). crt/ is COPYed whole (always
# present — has README.md), so the build ALSO works with NO CA.
#
# BUILD-TIME ONLY, and enforced as such: the append to certifi and the PIP_CERT /
# REQUESTS_CA_BUNDLE exports live INSIDE the install RUN below, and certifi is
# restored from a backup before that layer closes. Nothing about the proxy
# survives into the shipped image — an image built behind one proxy must not keep
# trusting that proxy's CA after it is deployed somewhere else. Runtime trust is a
# separate, mounted concern: compose/certs/ (see compose/certs/README.md).
#
# Published images never carry a CA at all: .github/workflows/build-image.yml
# builds from a clean checkout where crt/ holds only README.md.
COPY crt/ /tmp/proxy-crt/

# Install onto the litellm base so the proxy can import
# `corp_llm_gateway.bootstrap.guardrail`. NER_PROFILE selects how much of the
# sanitizing (NER) stack is baked in:
#   base   — [ner] libs (Natasha RU + spaCy EN) but NO downloaded models. The
#            default, for build environments that cannot reach github.com to fetch
#            the spaCy model wheel (or that supply models out-of-band). spaCy EN
#            degrades to the regex floor at runtime.
#   ru-en  — full bilingual: [ner] libs + the en_core_web_md model wheel, so BOTH
#            RU (Natasha, models bundled) and EN (spaCy) run non-degraded.
#   en     — EN only: spaCy + en_core_web_md, WITHOUT the RU (natasha/slovnet)
#            stack — a smaller image for non-RU deployments; RU input degrades to
#            the regex floor.
# The GitHub Actions build (.github/workflows/build-image.yml) publishes the ru-en
# and en variants — it runs on cloud runners that CAN reach github.com for the
# model wheel. [metrics] is intentionally left out of every profile to stay lean.
# Build-time knobs so the SAME Dockerfile builds both internet-connected (the
# GitHub Actions build, defaults below) and air-gapped/corp-mirror (ops override
# every knob to point at corp storage — Nexus/Artifactory/JFrog). Prod stays a
# self-contained image: nothing is fetched at deploy or runtime.
#   PIP_INDEX_URL    — corp PyPI mirror for the libraries; empty = public PyPI.
#                      A mirror whose TLS chains to the proxy CA above needs no
#                      further knob. One that does NOT is deliberately unsupported:
#                      --trusted-host would disable verification for artifacts that
#                      become executable code here, which contradicts the stack's
#                      own rule (compose/.env.example, "TLS verification is always
#                      ON"). Give the mirror a certificate we can chain instead.
#   EN_MODEL_VERSION — spaCy EN model version to bake (the NER-version knob; bump
#                      it + rebuild to ship a new NER version as a new image tag).
#   EN_MODEL_URL     — full wheel URL for the EN model; empty = derive the public
#                      github release URL from EN_MODEL_VERSION. Set it to the
#                      corp-storage URL when the build host cannot reach github.com.
ARG NER_PROFILE=base
ARG PIP_INDEX_URL=
ARG EN_MODEL_VERSION=3.8.0
ARG EN_MODEL_URL=
COPY --from=build /build/dist/*.whl /tmp/
RUN set -eux; \
    whl="$(ls /tmp/*.whl)"; \
    pip_idx=""; \
    if [ -n "${PIP_INDEX_URL}" ]; then pip_idx="--index-url ${PIP_INDEX_URL}"; fi; \
    en_model="${EN_MODEL_URL:-https://github.com/explosion/spacy-models/releases/download/en_core_web_md-${EN_MODEL_VERSION}/en_core_web_md-${EN_MODEL_VERSION}-py3-none-any.whl}"; \
    py=/app/.venv/bin/python; \
    "$py" -m ensurepip --upgrade; \
    certbundle="$("$py" -c 'import certifi; print(certifi.where())')"; \
    cp "$certbundle" /tmp/certifi.orig; \
    if [ -f /tmp/proxy-crt/proxy-ca.crt ]; then \
        cat /tmp/proxy-crt/proxy-ca.crt >> "$certbundle"; \
    fi; \
    export PIP_CERT="$certbundle" REQUESTS_CA_BUNDLE="$certbundle"; \
    case "${NER_PROFILE}" in \
      base)  "$py" -m pip install --no-cache-dir ${pip_idx} "${whl}[ner,postgres,oidc]" ;; \
      ru-en) "$py" -m pip install --no-cache-dir ${pip_idx} "${whl}[ner,postgres,oidc]" "${en_model}"; \
             "$py" -c "import spacy, natasha; spacy.load('en_core_web_md'); print('NER ru-en OK')" ;; \
      en)    "$py" -m pip install --no-cache-dir ${pip_idx} "${whl}[postgres,oidc]" "spacy>=3.8,<3.9" "${en_model}"; \
             "$py" -c "import spacy; spacy.load('en_core_web_md'); print('NER en OK')" ;; \
      *)     echo "unknown NER_PROFILE=${NER_PROFILE} (want: base|ru-en|en)" >&2; exit 1 ;; \
    esac; \
    cp /tmp/certifi.orig "$certbundle"; \
    "$py" -c "import corp_llm_gateway.bootstrap; print('gateway bootstrap import OK')"; \
    rm -f /tmp/*.whl /tmp/certifi.orig; \
    rm -rf /tmp/proxy-crt
# Record what got baked so ops can audit the running image with `docker inspect`.
LABEL org.corp-llm-gateway.ner-profile="${NER_PROFILE}" \
      org.corp-llm-gateway.en-model-version="${EN_MODEL_VERSION}"

# The pod mounts the litellm proxy config (with the guardrail callback) here via
# the configmap-litellm.yaml ConfigMap.
ENTRYPOINT ["litellm", "--config", "/etc/litellm/config.yaml", "--port", "4000"]
